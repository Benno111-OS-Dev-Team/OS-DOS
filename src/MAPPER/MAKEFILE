#
# OS-DOS mapper makefile
# CI-safe version:
# - keeps the checked-in mapper.lib
# - does not rebuild old DOS library scripts with modern MSVC lib.exe
#

all: mapper.lib

mapper.lib:
	@echo Using checked-in mapper.lib
	@if not exist mapper.lib echo ERROR: mapper.lib is missing && exit /b 1

clean:
	@echo Mapper clean: keeping mapper.lib and existing .obj files
