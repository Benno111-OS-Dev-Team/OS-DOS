#************************* makefile for messages **************************

country    =usa-ms

#
#######################	dependencies begin here. #########################
#

all: $(country).idx

$(country).idx: $(country).msg
!if [where buildidx >nul 2>nul]
	attrib -R $(country).msg
	buildidx $(country).msg
!else
	@echo buildidx not found; using checked-in $(country).idx
!endif
